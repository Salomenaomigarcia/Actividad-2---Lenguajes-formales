digraph NFA {
  rankdir=LR;
  node [shape=circle];
  __start [shape=point];
  q1 [label="1", shape=doublecircle];
  q2 [label="2", shape=circle];
  q3 [label="3", shape=circle];
  q4 [label="4", shape=doublecircle];
  q5 [label="5", shape=circle];
  __start -> q3;
  __start -> q5;
  q1 -> q1 [label="a"];
  q1 -> q5 [label="a"];
  q2 -> q1 [label="a"];
  q3 -> q2 [label="a"];
  q3 -> q4 [label="a"];
  q4 -> q5 [label="b"];
  q5 -> q1 [label="a"];
  q5 -> q4 [label="b"];
  q5 -> q5 [label="a"];
}
